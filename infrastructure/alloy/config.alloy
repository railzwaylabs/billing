discovery.docker "billing" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "billing_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "billing"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(admin-api|api|rating)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "billing_service"
  }

  rule {
    source_labels = ["billing_service"]
    regex         = "api"
    replacement   = "public-api"
    target_label  = "billing_service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }
}

loki.source.docker "billing" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.billing.targets
  labels        = { environment = "development", job = "billing" }
  relabel_rules = discovery.relabel.billing_logs.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
